    <string name="guardian_import_title">استورد ملف VPN حقيقيًا</string>
    <string name="guardian_import_body">لا يوجد ملف WireGuard محفوظ. استورد إعدادًا من مزود موثوق قبل الاتصال.</string>
    <string name="guardian_start_title">راجع اتصال VPN</string>
    <string name="guardian_start_body">يوجد ملف اتصال محفوظ لكن النفق غير نشط. ابدأ الاتصال من الرئيسية باختيارك.</string>
    <string name="guardian_vpn_issue_title">افحص مشكلة VPN</string>
    <string name="guardian_vpn_issue_body">وحدة التحكم أبلغت عن خطأ. راجع مركز الأمان قبل إعادة الاتصال.</string>
    <string name="guardian_transition_title">جارٍ تغيير حالة VPN</string>
    <string name="guardian_transition_body">أثناء الاتصال أو الفصل لا نفترض وجود نفق نشط. راجع حالة الجلسة.</string>
    <string name="guardian_verify_title">تحقق من دلائل حماية النفق</string>
    <string name="guardian_verify_body">وحدة WireGuard تشير إلى نفق، لكن لا توجد مصافحة حديثة متاحة. هذا مجهول وليس دليل تسرب.</string>
    <string name="guardian_offline_title">الشبكة غير متاحة</string>
    <string name="guardian_offline_body">Android لا يبلغ عن شبكة نشطة. افحص الاتصال قبل اتهام VPN.</string>
    <string name="guardian_captive_title">الشبكة قد تحتاج تسجيل دخول</string>
    <string name="guardian_captive_body">Android أبلغ عن بوابة دخول للشبكة. راجع حالة التسجيل.</string>
    <string name="guardian_net_unverified_title">صلاحية الإنترنت غير مؤكدة</string>
    <string name="guardian_net_unverified_body">لم يؤكد Android توفر الإنترنت. هذا لا يثبت وحده انقطاع الخدمة.</string>
    <string name="guardian_net_unknown_title">تعذرت قراءة الشبكة</string>
    <string name="guardian_net_unknown_body">لم يتمكن Guardian من قراءة حالة الشبكة. افتح طبيب الشبكة للتشخيص.</string>
    <string name="guardian_dns_title">Android لم يبلغ عن DNS</string>
    <string name="guardian_dns_body">لم تُبلغ الشبكة النشطة عن خوادم DNS. هذا لا يعني ثبوت تسرب DNS.</string>
    <string name="guardian_low_storage_title">مساحة التخزين منخفضة</string>
    <string name="guardian_low_storage_body">المساحة المتاحة في وحدة التخزين الداخلية 10 بالمئة أو أقل. راجع الملفات قبل أي حذف.</string>
    <string name="guardian_storage_unknown_title">تعذرت قراءة التخزين</string>
    <string name="guardian_storage_unknown_body">تعذر قياس حجم التخزين الداخلي. افتح أشعة التخزين لفحص متخصص.</string>
    <string name="guardian_cache_title">راجع ملفات KX المؤقتة</string>
    <string name="guardian_cache_body">توجد بيانات كاش مقاسة لـKX. راجع المرشحين أولًا؛ حجم الكاش ليس ضمانًا لمساحة مسترجعة.</string>
    <string name="guardian_apps_unknown_title">تعذرت قراءة التطبيقات</string>
    <string name="guardian_apps_unknown_body">لم يوفر Android قائمة تطبيقات المشغل المرئية. راجع الصلاحيات وقائمة التطبيقات.</string>
    <string name="guardian_apps_review_title">راجع التطبيقات المرئية</string>
    <string name="guardian_apps_review_body">افحص التطبيقات وخيارات إدارتها. أي إزالة تتطلب موافقة Android.</string>
    <string name="guardian_no_actions_title">لا إجراءات مقترحة</string>
    <string name="guardian_no_actions_body">لا توجد مشكلة تستدعي إجراءً في القياسات المتاحة لهذا الفحص.</string>
