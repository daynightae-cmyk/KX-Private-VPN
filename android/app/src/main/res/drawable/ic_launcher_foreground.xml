<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: the KX glass-orb emblem reduced to a clean vector.
  Drawn inside the 108dp adaptive canvas with the safe-zone margin preserved so
  the launcher mask never clips the ring. Colors match the approved identity.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer glass ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#64EEFF"
        android:strokeWidth="1.6"
        android:pathData="M54,22 A32,32 0,1 0,54,86 A32,32 0,1 0,54,22 Z" />
    <!-- Inner pearl ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#AD71FF"
        android:strokeWidth="1.1"
        android:pathData="M54,27 A27,27 0,1 0,54,81 A27,27 0,1 0,54,27 Z" />
    <!-- KX wordmark strokes -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F9ECFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,40 L40,68 M40,54 L50,40 M40,54 L50,68" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F9ECFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M58,40 L70,54 M70,40 L58,54 M58,68 L70,54" />
</vector>
